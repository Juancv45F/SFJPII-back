doctype html
html(lang="es")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title || 'Super Admin'
    style.
      :root { --bg:#0b1220; --card:#0f172a; --muted:#94a3b8; --text:#e2e8f0; --line:#1f2a44; --accent:#22c55e; --danger:#ef4444; --warn:#f59e0b; }
      body { margin:0; font-family: Arial, Helvetica, sans-serif; background:#0b1220; color:var(--text); }
      a { color: var(--text); text-decoration:none; }
      .wrap { max-width: 1150px; margin:0 auto; padding: 18px; }
      .top { display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--line); background:rgba(255,255,255,0.02); }
      .brand { font-weight:700; letter-spacing:0.3px; }
      .nav a { margin-left: 14px; color: var(--muted); }
      .nav a:hover { color: var(--text); }
      .card { background: rgba(255,255,255,0.03); border:1px solid var(--line); border-radius: 14px; padding: 16px; }
      .grid { display:grid; grid-template-columns: 1fr 1fr; gap: 14px; }
      .kpi { display:flex; align-items:flex-start; justify-content:space-between; gap: 12px; }
      .kpi .label { color: var(--muted); font-size: 12px; }
      .kpi .value { font-size: 26px; font-weight: 700; margin-top: 6px; }
      .muted { color: var(--muted); }
      input, select { background:#0b1220; color:var(--text); border:1px solid var(--line); border-radius: 10px; padding: 10px 12px; width:100%; box-sizing:border-box; }
      button { background: rgba(255,255,255,0.06); border:1px solid var(--line); color:var(--text); border-radius: 10px; padding: 10px 12px; cursor:pointer; }
      button:hover { background: rgba(255,255,255,0.10); }
      .btnPrimary { border-color: rgba(34,197,94,0.45); }
      .btnDanger { border-color: rgba(239,68,68,0.45); }
      .btnWarn { border-color: rgba(245,158,11,0.45); }
      table { width:100%; border-collapse: collapse; }
      th, td { border-bottom:1px solid var(--line); padding: 10px 8px; text-align:left; vertical-align: top; }
      th { color: var(--muted); font-weight: 700; font-size: 12px; }
      .pill { display:inline-block; padding: 4px 8px; border-radius: 999px; font-size: 12px; border:1px solid var(--line); color: var(--muted); }
      .pill.ok { border-color: rgba(34,197,94,0.45); color: #86efac; }
      .pill.warn { border-color: rgba(245,158,11,0.45); color: #fde68a; }
      .pill.bad { border-color: rgba(239,68,68,0.45); color: #fca5a5; }
      .row { display:flex; gap: 10px; align-items:center; }
      .row > * { flex: 1; }
      .actions { display:flex; flex-wrap:wrap; gap: 8px; }
      .actions form { margin:0; }
      .small { font-size: 12px; }
      canvas { width: 100%; display: block; }
  body
    .top
      .wrap
        .row
          .brand SFJPII · Super Admin
          if superAdmin
            .nav
              a(href="/superadmin") Dashboard
              a(href="/superadmin/users") Usuarios
              a(href="/superadmin/logs") Logs
              a(href="/superadmin/logout") Salir
    .wrap
      block content
